+static bool check_rx_completed_retransmission_coalescing()
+{
+    RGMIIVerif verif;
+    bool evicted = false;
+    bool coalesced = false;
+    constexpr uint64_t key = 0x1234;
+    if (!verif.push_rx_packet_priority_limited(
+            {0xa1}, 4, true, key, evicted, coalesced)) {
+        std::print("EthGig RX recent coalescing ERROR: initial packet failed\n");
+        return false;
+    }
+    verif.step(false, 0, false);
+    verif.step(false, 0, false);
+    if (verif.pending_rx_packets() != 0) {
+        std::print("EthGig RX recent coalescing ERROR: packet did not complete\n");
+        return false;
+    }
+    for (size_t retry = 0; retry < 3; ++retry) {
+        if (!verif.push_rx_packet_priority_limited(
+                {uint8_t(0xb1 + retry)}, 4, true, key, evicted, coalesced) ||
+            evicted || !coalesced || verif.pending_rx_packets() != 0) {
+            std::print("EthGig RX recent coalescing ERROR: retry {} was queued\n",
+                retry + 1);
+            return false;
+        }
+    }
+    // Periodically admit a retransmission so recovery remains possible if the
+    // completed RGMII frame was lost by the guest DMA ring.
+    if (!verif.push_rx_packet_priority_limited(
+            {0xc1}, 4, true, key, evicted, coalesced) || evicted ||
+        coalesced || verif.pending_rx_packets() != 1) {
+        std::print("EthGig RX recent coalescing ERROR: recovery retry dropped\n");
+        return false;
+    }
+    // Distinct TCP work is never suppressed by the recent-key cache.
+    if (!verif.push_rx_packet_priority_limited(
+            {0xd1}, 4, true, 0x5678, evicted, coalesced) || evicted ||
+        coalesced || verif.pending_rx_packets() != 2) {
+        std::print("EthGig RX recent coalescing ERROR: distinct range dropped\n");
+        return false;
+    }
+    return true;
+}
