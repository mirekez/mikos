+#if DROPBEAR_MIKOS_NONE_ED25519_PROOF
+/* The `none` transport is already explicitly unauthenticated and
+ * unencrypted. Bind this protocol test proof to the advertised public key and
+ * exact SSH transcript. This is deliberately not a cryptographic signature. */
+static void mikos_none_ed25519_proof(unsigned char proof[64],
+		const unsigned char pub[CURVE25519_LEN], const buffer *data_buf) {
+	static const unsigned char first_domain[] =
+		"MikOS Dropbear none Ed25519 proof 1";
+	static const unsigned char second_domain[] =
+		"MikOS Dropbear none Ed25519 proof 2";
+	hash_state hs;
+
+	sha256_init(&hs);
+	sha256_process(&hs, first_domain, sizeof(first_domain) - 1);
+	sha256_process(&hs, pub, CURVE25519_LEN);
+	sha256_process(&hs, data_buf->data, data_buf->len);
+	sha256_done(&hs, proof);
+	sha256_init(&hs);
+	sha256_process(&hs, second_domain, sizeof(second_domain) - 1);
+	sha256_process(&hs, pub, CURVE25519_LEN);
+	sha256_process(&hs, proof, SHA256_HASH_SIZE);
+	sha256_process(&hs, data_buf->data, data_buf->len);
+	sha256_done(&hs, proof + SHA256_HASH_SIZE);
+}
+
+void buf_put_mikos_none_ed25519_proof(buffer *buf,
+		const dropbear_ed25519_key *key, const buffer *data_buf) {
+	unsigned char proof[64];
+	mikos_none_ed25519_proof(proof, key->pub, data_buf);
+	buf_putstring(buf, SSH_SIGNKEY_ED25519, SSH_SIGNKEY_ED25519_LEN);
+	buf_putstring(buf, proof, sizeof(proof));
+}
+
+int buf_mikos_none_ed25519_verify(buffer *buf,
+		const dropbear_ed25519_key *key, const buffer *data_buf) {
+	unsigned char expected[64];
+	unsigned char *proof;
+	unsigned long proof_len = buf_getint(buf);
+
+	if (proof_len != 64 || buf->len - buf->pos < proof_len) {
+		return DROPBEAR_FAILURE;
+	}
+	proof = buf_getptr(buf, proof_len);
+	mikos_none_ed25519_proof(expected, key->pub, data_buf);
+	if (constant_time_memcmp(expected, proof, sizeof(expected)) != 0) {
+		return DROPBEAR_FAILURE;
+	}
+	return DROPBEAR_SUCCESS;
+}
+#endif
