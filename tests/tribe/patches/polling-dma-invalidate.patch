diff --git a/tribe/tests/EthGigCPU_test.cpp b/tribe/tests/EthGigCPU_test.cpp
--- a/tribe/tests/EthGigCPU_test.cpp
+++ b/tribe/tests/EthGigCPU_test.cpp
@@ -126,8 +126,26 @@ static bool check_eth_dma_cache_invalidate_policy()
     if (TestTribe::eth_dma_needs_cache_invalidate(false, false)) {
         std::print("EthGig cache invalidate ERROR: idle DMA must not invalidate CPU cache\n");
         ok = false;
     }
+
+    bool pending = false;
+    pending = TestTribe::eth_dma_cache_invalidate_next(true, pending, true);
+    if (!pending) {
+        std::print("EthGig cache invalidate ERROR: RX completion did not raise a pulse\n");
+        ok = false;
+    }
+    pending = TestTribe::eth_dma_cache_invalidate_next(true, pending, true);
+    if (pending) {
+        std::print("EthGig cache invalidate ERROR: RX pulse did not clear for retrigger\n");
+        ok = false;
+    }
+    pending = TestTribe::eth_dma_cache_invalidate_next(true, pending, true);
+    if (!pending) {
+        std::print("EthGig cache invalidate ERROR: held RX IRQ did not retrigger\n");
+        ok = false;
+    }
+
     return ok;
 }
