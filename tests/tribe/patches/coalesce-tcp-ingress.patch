+inline uint64_t eth_tap_tcp_queue_key(const std::vector<uint8_t>& frame)
+{
+    if (frame.size() < 54 || frame[12] != 0x08u || frame[13] != 0x00u ||
+        frame[23] != 6) {
+        return 0;
+    }
+    const size_t ip_header = (frame[14] & 0x0fu) * 4u;
+    if (ip_header < 20 || frame.size() < 14 + ip_header + 20) {
+        return 0;
+    }
+    const size_t tcp = 14 + ip_header;
+    const size_t tcp_header = (frame[tcp + 12] >> 4) * 4u;
+    const uint16_t ip_length = (uint16_t(frame[16]) << 8) | frame[17];
+    if (tcp_header < 20 || ip_length < ip_header + tcp_header ||
+        frame.size() < 14 + ip_length) {
+        return 0;
+    }
+
+    // Ignore the IPv4 ID/checksums and TCP timestamps, which legitimately
+    // change on a retransmission. Hash the flow, sequence/ACK range, flags,
+    // window, and payload length so identical queued TCP work is coalesced.
+    uint64_t key = 1469598103934665603ull;
+    const auto mix = [&key](uint8_t byte) {
+        key = (key ^ byte) * 1099511628211ull;
+    };
+    for (size_t index = 26; index < 34; ++index) mix(frame[index]);
+    for (size_t index = tcp; index < tcp + 16; ++index) mix(frame[index]);
+    mix(frame[16]);
+    mix(frame[17]);
+    return key == 0 ? 1 : key;
+}
