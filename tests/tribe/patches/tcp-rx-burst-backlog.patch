+    ipv6[12] = 0x86;
+    ipv6[13] = 0xdd;
+    if (!eth_tap_supports_mikos_frame(ipv4) ||
+        !eth_tap_supports_mikos_frame(arp) ||
+        eth_tap_supports_mikos_frame(ipv6) ||
+        eth_tap_supports_mikos_frame(std::vector<uint8_t>(13))) {
+        std::print("EthGig RX protocol filter ERROR\n");
+        ok = false;
+    }
+    return ok;
+}
