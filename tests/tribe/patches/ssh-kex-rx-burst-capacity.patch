+static bool check_rx_kex_burst_capacity()
+{
+    if (eth_tap_rx_backlog_capacity < 8) {
+        std::print("EthGig RX KEX burst ERROR: backlog capacity too small\n");
+        return false;
+    }
+    RGMIIVerif verif;
+    bool evicted = false;
+    bool coalesced = false;
+    for (size_t index = 0; index < eth_tap_rx_backlog_capacity; ++index) {
+        if (!verif.push_rx_packet_priority_limited(
+                {uint8_t(index + 1)}, eth_tap_rx_backlog_capacity, true,
+                index + 1, evicted, coalesced) || evicted || coalesced) {
+            std::print("EthGig RX KEX burst ERROR: distinct frame {} dropped\n",
+                index);
+            return false;
+        }
+    }
+    if (verif.pending_rx_packets() != eth_tap_rx_backlog_capacity) {
+        std::print("EthGig RX KEX burst ERROR: queue size mismatch\n");
+        return false;
+    }
+    if (verif.push_rx_packet_priority_limited(
+            {0xff}, eth_tap_rx_backlog_capacity, true, 0xffff,
+            evicted, coalesced) || evicted || coalesced) {
+        std::print("EthGig RX KEX burst ERROR: full payload queue reordered\n");
+        return false;
+    }
+    return true;
+}
