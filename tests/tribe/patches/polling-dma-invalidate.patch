+++ b/tribe/TribeTest.h
@@ -754,9 +754,20 @@ public:
     static constexpr bool eth_dma_needs_cache_invalidate(bool tx_irq, bool rx_irq)
     {
         (void)tx_irq;
         return rx_irq;
     }
-
+    static constexpr bool eth_dma_cache_invalidate_next(
+        bool rx_irq, bool pending, bool ready)
+    {
+        // Emit distinct invalidate pulses while RX completion remains high.
+        // Software may clear and repost the descriptor between testbench
+        // samples, so a one-edge latch can hide the next DMA completion.
+        if (pending && ready) {
+            return false;
+        }
+        return rx_irq || pending;
+    }
+
     void set_uart_script_delay(uint32_t delay)
     {
         uart_script_delay_reg.set((u32)delay);
