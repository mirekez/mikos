+inline bool eth_tap_supports_mikos_frame(const std::vector<uint8_t>& frame)
+{
+    // MikOS currently implements ARP and IPv4 only. A host TAP can emit IPv6
+    // multicast in wall time while the cycle model is busy for minutes; those
+    // irrelevant frames must not evict a pending TCP record from the bounded
+    // simulated RX queue.
+    return frame.size() >= 14 && frame[12] == 0x08u &&
+        (frame[13] == 0x00u || frame[13] == 0x06u);
+}
